{
  "name": "@masterplaycoding/eventlab-cli",
  "version": "0.2.1",
  "description": "Command line for EventLab: run a scenario, replay a saved plan, render a report.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "webhooks",
    "testing",
    "cli",
    "event-driven"
  ],
  "bin": {
    "eventlab": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterplaYCoding/EventLab.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/MasterplaYCoding/EventLab/issues"
  },
  "homepage": "https://github.com/MasterplaYCoding/EventLab#readme",
  "author": "Matei Ursache",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@masterplaycoding/eventlab": "0.2.1"
  }
}
